{
  "name": "zyte-api",
  "version": "0.2.0",
  "description": "Node.js TypeScript client for Zyte API /v1/extract.",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./generated": {
      "types": "./dist/generated/openapi-types.d.ts",
      "import": "./dist/generated/openapi-types.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "generate:types": "node scripts/generate-openapi-types.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test test/**/*.test.ts",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/client.ts --test-coverage-include=src/errors.ts --test-coverage-include=src/http.ts --test-coverage-include=src/utils.ts --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 test/**/*.test.ts",
    "verify": "npm run generate:types -- --check && npm run typecheck && npm run lint && npm run test:coverage && npm run build && npm pack --dry-run && node -e \"import('./dist/index.js').then((m)=>{ if (!m.ZyteClient) throw new Error('missing export') })\"",
    "prepack": "npm run build"
  },
  "keywords": [
    "zyte",
    "scraping",
    "node",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "typescript": "6.0.3",
    "@types/node": "25.9.3"
  },
  "author": {
    "name": "Alan Hoffmeister",
    "email": "alanhoffmeister@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alanhoff/node-zyte-api.git"
  },
  "bugs": {
    "url": "https://github.com/alanhoff/node-zyte-api/issues"
  },
  "homepage": "https://github.com/alanhoff/node-zyte-api#readme",
  "sideEffects": false
}
